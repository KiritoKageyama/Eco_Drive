<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- Interactive OSM Map Background -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/tvSpeedometer"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="120dp"
        android:background="@drawable/handle_bg"
        android:gravity="center"
        android:text="0\nkm/h"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:elevation="6dp" />

    <!-- Floating Live HUD (Overlays Map) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardLiveHud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="48dp"
        app:cardBackgroundColor="#CC1E1E1E"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/colorAccent"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/tvLiveSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextPrimary"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="km/h"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextSecondary"/>
            </LinearLayout>
            <View
                android:layout_width="1dp"
                android:layout_height="40dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:background="@color/colorStroke"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/tvLiveCo2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.0"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorAccent"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="g/sec CO2"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextSecondary"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom Sheet Dashboard -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_hideable="false"
        app:behavior_peekHeight="70dp"
        app:behavior_saveFlags="all"
        android:background="@drawable/bottom_sheet_bg"
        android:elevation="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Handle Graphic -->
            <View
                android:layout_width="48dp"
                android:layout_height="5dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/handle_bg"
                android:layout_marginBottom="16dp" />

            <!-- Navigation Bar -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginEnd="16dp">
                        <ImageView
                            android:id="@+id/btnOpenDynamicTest"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:padding="8dp"
                            android:src="@android:drawable/ic_menu_directions"
                            app:tint="@color/colorAccent"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="Dynamic Test"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Route Test"
                            android:textSize="10sp"
                            android:textColor="@color/colorTextSecondary"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginEnd="16dp">
                        <ImageView
                            android:id="@+id/btnOpenComparison"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:padding="8dp"
                            android:src="@android:drawable/ic_menu_mapmode"
                            app:tint="@color/colorAccent"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="Compare Routes"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Compare"
                            android:textSize="10sp"
                            android:textColor="@color/colorTextSecondary"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginEnd="16dp">
                        <ImageView
                            android:id="@+id/btnOpenDashboard"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:padding="8dp"
                            android:src="@android:drawable/ic_menu_recent_history"
                            app:tint="@color/colorAccent"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="Dashboard"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dashboard"
                            android:textSize="10sp"
                            android:textColor="@color/colorTextSecondary"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginEnd="16dp">
                        <ImageView
                            android:id="@+id/btnOpenSensitivity"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:padding="8dp"
                            android:src="@android:drawable/ic_menu_manage"
                            app:tint="@color/colorAccent"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="Sensitivity Analysis"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Analysis"
                            android:textSize="10sp"
                            android:textColor="@color/colorTextSecondary"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginEnd="16dp">
                        <ImageView
                            android:id="@+id/btnOpenChat"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:padding="8dp"
                            android:src="@android:drawable/ic_menu_send"
                            app:tint="@color/colorAccent"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="AI Chat"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AI Chat"
                            android:textSize="10sp"
                            android:textColor="@color/colorTextSecondary"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:id="@+id/btnOpenSettings"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:padding="8dp"
                            android:src="@android:drawable/ic_menu_preferences"
                            app:tint="@color/colorAccent"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="Settings"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Settings"
                            android:textSize="10sp"
                            android:textColor="@color/colorTextSecondary"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EcoDrive Core"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"/>
                <ImageView
                    android:id="@+id/btnMoreOptions"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@android:drawable/ic_menu_more"
                    app:tint="@color/colorAccent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="More Options"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
                
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Physics-Informed Real-time ML Pipeline"
                android:textColor="@color/colorTextSecondary"
                android:textSize="14sp"
                android:layout_marginBottom="24dp"/>

            <!-- Vehicle Selection Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/colorCardBackground"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/colorStroke"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VEHICLE METADATA"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextSecondary"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxBackgroundColor="@color/colorBackground"
                        app:boxStrokeColor="@color/colorStroke"
                        android:layout_marginBottom="8dp">
                        <AutoCompleteTextView
                            android:id="@+id/spinnerCategory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Select Vehicle Model"
                            android:inputType="none"
                            android:textColor="@color/colorTextPrimary"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxBackgroundColor="@color/colorBackground"
                        app:boxStrokeColor="@color/colorStroke">
                        <AutoCompleteTextView
                            android:id="@+id/spinnerFuelType"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Select Fuel Type"
                            android:inputType="none"
                            android:textColor="@color/colorTextPrimary"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- AI Thought Stream Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAiThoughtStream"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#1A237E"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeWidth="1dp"
                app:strokeColor="#3F51B5"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="ON-DEVICE AI THOUGHT STREAM"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#C5CAE9"
                            android:letterSpacing="0.1"/>
                        <ProgressBar
                            android:id="@+id/pbAiThinking"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:visibility="gone"
                            android:indeterminateTint="#C5CAE9"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvAiThoughtStream"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Awaiting telemetry for real-time analysis..."
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="14sp"
                        android:fontFamily="serif"
                        android:lineSpacingExtra="2dp"
                        android:fontStyle="italic"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Telemetry & Routing Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/colorCardBackground"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/colorStroke"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="STATIC ROUTING &amp; TELEMETRY"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextSecondary"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="16dp"/>

                    <!-- Auto-Origin Display -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_menu_mylocation"
                            app:tint="@color/colorAccent"
                            android:layout_marginEnd="12dp"/>
                            
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Current Location (Auto)"
                                android:textSize="12sp"
                                android:textColor="@color/colorTextSecondary"/>
                            <TextView
                                android:id="@+id/tvCurrentLocation"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Fetching GPS..."
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/colorTextPrimary"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Optional Destination Toggle -->
                    <TextView
                        android:id="@+id/tvAddDestination"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+ Add Destination (Optional)"
                        android:textColor="@color/colorAccent"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:paddingTop="8dp"
                        android:paddingBottom="16dp"/>

                    <!-- Geocoding Inputs (Hidden by Default) -->
                    <LinearLayout
                        android:id="@+id/layoutDestination"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp"
                        android:visibility="gone">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                            app:boxBackgroundColor="@color/colorBackground"
                            app:boxStrokeColor="@color/colorStroke"
                            app:boxCornerRadiusTopStart="8dp"
                            app:boxCornerRadiusTopEnd="8dp"
                            app:boxCornerRadiusBottomStart="8dp"
                            app:boxCornerRadiusBottomEnd="8dp"
                            android:hint="Search Destination City..."
                            android:textColorHint="@color/colorTextSecondary">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etEndLoc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/colorTextPrimary"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFetchTelemetry"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="Fetch Live OpenStreetMap Data"
                        app:cornerRadius="12dp"
                        app:backgroundTint="#292929"
                        android:textColor="@color/colorTextPrimary"
                        android:letterSpacing="0.0"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/colorStroke"
                        android:layout_marginBottom="16dp"/>

                    <!-- Real-time Detailed Weather & Route Info Window -->
                    <LinearLayout
                        android:id="@+id/cardLiveWeatherRoute"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_weather_card"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:layout_marginBottom="24dp"
                        android:elevation="6dp"
                        android:visibility="visible">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LIVE WEATHER &amp; TELEMETRY"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#BBDEFB"
                            android:letterSpacing="0.15"
                            android:layout_marginBottom="16dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- Row 1: Temp & Condition -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:baselineAligned="false"
                                android:layout_marginBottom="16dp">
                                <!-- Temperature -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌡️ Temperature" android:textSize="11sp" android:textColor="#E3F2FD" android:layout_marginBottom="4dp"/>
                                    <TextView android:id="@+id/tvMainTemp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°C" android:textSize="32sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
                                </LinearLayout>
                                <!-- Condition -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌤️ Conditions" android:textSize="11sp" android:textColor="#E3F2FD" android:layout_marginBottom="4dp"/>
                                    <TextView android:id="@+id/tvWeatherCondition" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Awaiting Data" android:textSize="18sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Row 2: Wind/Humidity & Area Type -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:baselineAligned="false"
                                android:layout_marginBottom="16dp">
                                <!-- Wind/Humidity -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💨 Wind | 💧 Humidity" android:textSize="11sp" android:textColor="#E3F2FD" android:layout_marginBottom="4dp"/>
                                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                                        <TextView android:id="@+id/tvWindSpeed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- m/s" android:textSize="16sp" android:textStyle="bold" android:textColor="#FFFFFF" android:layout_marginEnd="12dp"/>
                                        <TextView android:id="@+id/tvHumidity" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--%" android:textSize="16sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
                                    </LinearLayout>
                                </LinearLayout>
                                <!-- Area Type -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🛣️ Terrain Setup" android:textSize="11sp" android:textColor="#E3F2FD" android:layout_marginBottom="4dp"/>
                                    <TextView android:id="@+id/tvRoadArea" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textSize="16sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
                                </LinearLayout>
                            </LinearLayout>
                            
                            <!-- Row 3: Traffic Condition -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:background="#33FFFFFF"
                                android:padding="12dp"
                                android:layout_marginTop="4dp">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🚦 Estimated Traffic Flow" android:textSize="11sp" android:textColor="#E3F2FD" android:layout_marginBottom="2dp"/>
                                    <TextView android:id="@+id/tvTrafficCondition" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Scanning..." android:textSize="16sp" android:textStyle="bold" android:textColor="#FFCA28"/>
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Extracted Variables Display -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <EditText android:id="@+id/etDistance"
                                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                                android:hint="Dist (km)" android:text="15.0" android:textColorHint="@color/colorTextSecondary"
                                android:textColor="@color/colorTextPrimary" android:backgroundTint="@color/colorStroke"
                                android:layout_marginEnd="8dp" android:layout_marginBottom="12dp"/>

                            <EditText android:id="@+id/etSpeed"
                                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                                android:hint="Speed (km/h)" android:text="40.0" android:textColorHint="@color/colorTextSecondary"
                                android:textColor="@color/colorTextPrimary" android:backgroundTint="@color/colorStroke"
                                android:layout_marginStart="8dp" android:layout_marginBottom="12dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <EditText android:id="@+id/etAccel"
                                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                                android:hint="Accel (m/s²)" android:text="0.5" android:textColorHint="@color/colorTextSecondary"
                                android:textColor="@color/colorTextPrimary" android:backgroundTint="@color/colorStroke"
                                android:layout_marginEnd="8dp"/>

                            <EditText android:id="@+id/etGrade"
                                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                                android:hint="Grade (%)" android:text="0.0" android:textColorHint="@color/colorTextSecondary"
                                android:textColor="@color/colorTextPrimary" android:backgroundTint="@color/colorStroke"
                                android:layout_marginStart="8dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical">
                        
                        <!-- Hidden stop ratio element since we calculate it natively -->
                        <EditText android:id="@+id/etStopRatio"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:visibility="gone"
                            android:text="0.2"/>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchAc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="A/C Load Active"
                            android:textColor="@color/colorTextPrimary"
                            app:thumbTint="#1E1E1E"
                            app:trackTint="@color/colorAccent"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Quick Live Tracking Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/colorCardBackground"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/colorStroke"
                android:layout_marginBottom="24dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LIVE GPS EXPERIMENT"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorAccent"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:id="@+id/tvLiveMetrics"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Awaiting GPS Fix..."
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="14sp"
                        android:layout_marginBottom="16dp"/>
                        
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToggleTracking"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="START LIVE SESSION"
                        app:cornerRadius="12dp"
                        app:backgroundTint="@color/colorAccent"
                        android:textColor="@color/colorBackground"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Demo Scenarios Horizontal Scroll -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QUICK TEST SCENARIOS"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/colorAccent"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDemoEco"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌱 Eco Route"
                        android:textSize="12sp"
                        app:cornerRadius="8dp"
                        app:backgroundTint="#1B5E20"
                        android:layout_marginEnd="8dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDemoAggressive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏎️ Aggressive"
                        android:textSize="12sp"
                        app:cornerRadius="8dp"
                        app:backgroundTint="#B71C1C"
                        android:layout_marginEnd="8dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDemoTraffic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🚦 Heavy Traffic"
                        android:textSize="12sp"
                        app:cornerRadius="8dp"
                        app:backgroundTint="#E65100"/>
                </LinearLayout>
            </HorizontalScrollView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalculate"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="RUN STATIC ML REPORT"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:backgroundTint="@color/colorTextPrimary"
                android:textColor="@color/colorBackground"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:id="@+id/tvResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Awaiting route initialization..."
                android:textColor="@color/colorTextPrimary"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="16dp"/>

            <!-- Explainability Panel (Integrated) -->
            <include layout="@layout/layout_explainability_panel" />

            <!-- Visual Analytics Charts -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EMISSIONS COMPARISON (kg CO2)"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextSecondary"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp"/>

            <com.github.mikephil.charting.charts.BarChart
                android:id="@+id/barChartEmissions"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RESISTANCE FORCES / ENERGY BREAKDOWN"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextSecondary"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp"/>

            <com.github.mikephil.charting.charts.PieChart
                android:id="@+id/pieChartEnergy"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginBottom="32dp" />
                
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
