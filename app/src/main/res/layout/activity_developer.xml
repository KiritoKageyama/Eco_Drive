<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:padding="16dp">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarDev"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="Developer System Console"
        app:titleTextColor="#00FF00" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#1A1A1A"
        app:cardCornerRadius="12dp"
        app:strokeWidth="1dp"
        app:strokeColor="#00FF00"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MODEL VERIFICATION"
                android:textColor="#00FF00"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <Spinner
                android:id="@+id/spinnerModelSelect"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#00FF00" />

            <EditText
                android:id="@+id/etManualModelUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Custom Download URL (Overrides Preset)"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:textSize="12sp"
                android:backgroundTint="#00FF00" />

            <EditText
                android:id="@+id/etHfToken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Hugging Face Access Token (For Gemma Models)"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:textSize="12sp"
                android:backgroundTint="#00FF00"
                android:inputType="textPassword" />




            <TextView
                android:id="@+id/tvModelStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scanning for Gemma Assets..."
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace" />

            <Button
                android:id="@+id/btnDownloadModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DOWNLOAD GEMMA MODEL"
                android:layout_marginTop="12dp"
                android:backgroundTint="#333333"
                android:textColor="#00FF00"
                android:visibility="gone"/>

            <ProgressBar
                android:id="@+id/pbDownload"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                android:progressTint="#00FF00"
                android:indeterminate="false"/>
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="SYSTEM LOGS (REVERSED)"
            android:textColor="#00FF00"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnClearLogs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CLEAR"
            android:textColor="#FF5252"
            android:textSize="12sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#050505">

        <TextView
            android:id="@+id/tvDevLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Initializing logs..."
            android:textColor="#00FF00"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:padding="8dp" />
    </ScrollView>

</LinearLayout>
